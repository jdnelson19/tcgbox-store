# Use Shopify's actual *.myshopify.com domain for the Storefront API, not tcgbox.store.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
# Public Shopify storefront URL; use this for links to Shopify's shop landing page.
VITE_SHOPIFY_PUBLIC_STORE_URL=https://shop.tcgbox.store
# Optional JSON form endpoint. Defaults to FormSubmit's AJAX endpoint for orders@tcgbox.store.
VITE_FORMS_ENDPOINT=
